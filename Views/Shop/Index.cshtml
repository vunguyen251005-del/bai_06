@model IEnumerable<Product>
@using ThuongMaiDienTu.Models

@{
    ViewData["Title"] = "Cua hang";
    var categories = (IEnumerable<Category>)ViewBag.Categories;
}

<section class="shop-hero mb-4">
    <div>
        <h1>TechStore</h1>
        <p>Du an thuong mai dien tu ASP.NET Core MVC voi EF Core, Identity, phan quyen va gio hang.</p>
    </div>
</section>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-5">
        <label class="form-label">Tim san pham</label>
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Nhap ten san pham..." />
    </div>
    <div class="col-md-4">
        <label class="form-label">Danh muc</label>
        <select name="categoryId" class="form-select">
            <option value="">Tat ca</option>
            @foreach (var category in categories)
            {
                <option value="@category.Id" selected="@(ViewBag.CategoryId == category.Id)">@category.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <button class="btn btn-primary w-100" type="submit">Loc san pham</button>
    </div>
</form>

<div class="row g-4">
    @foreach (var product in Model)
    {
        <div class="col-sm-6 col-lg-4">
            <div class="card product-card h-100">
                <img src="@(product.ImageUrl ?? "https://placehold.co/900x600?text=Product")" class="card-img-top" alt="@product.Name" />
                <div class="card-body d-flex flex-column">
                    <span class="badge text-bg-light align-self-start mb-2">@product.Category?.Name</span>
                    <h2 class="h5">@product.Name</h2>
                    <p class="text-muted flex-grow-1">@product.Description</p>
                    <p class="fs-5 fw-bold text-primary">@product.Price.ToString("N0") VND</p>
                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-secondary flex-fill">Chi tiet</a>
                        <a asp-controller="Cart" asp-action="Add" asp-route-id="@product.Id" class="btn btn-primary flex-fill">Them gio</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
