@model ShoppingCartViewModel

@{
    ViewData["Title"] = "Gio hang";
}

<h1 class="h3 mb-3">Gio hang</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (!Model.Items.Any())
{
    <div class="alert alert-info">Gio hang dang trong.</div>
    <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Mua sam ngay</a>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>San pham</th>
                <th class="text-end">Gia</th>
                <th class="text-center">So luong</th>
                <th class="text-end">Thanh tien</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>
                    <div class="d-flex align-items-center gap-3">
                        <img src="@(item.ImageUrl ?? "https://placehold.co/120x80?text=Product")" class="cart-thumb" alt="@item.ProductName" />
                        <strong>@item.ProductName</strong>
                    </div>
                </td>
                <td class="text-end">@item.Price.ToString("N0") VND</td>
                <td class="text-center">
                    <form asp-action="Update" method="post" class="d-inline-flex gap-2">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <input type="number" name="quantity" value="@item.Quantity" min="0" class="form-control form-control-sm cart-qty" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">Cap nhat</button>
                    </form>
                </td>
                <td class="text-end">@item.Total.ToString("N0") VND</td>
                <td class="text-end">
                    <a asp-action="Remove" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-danger">Xoa</a>
                </td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Tong tien</th>
                <th class="text-end">@Model.Total.ToString("N0") VND</th>
                <th></th>
            </tr>
        </tfoot>
    </table>
    <div class="d-flex justify-content-end gap-2">
        <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-secondary">Tiep tuc mua</a>
        <a asp-action="Checkout" class="btn btn-success">Thanh toan</a>
    </div>
}
